	(text "Switches not normally fitted,\nJ4 allows the pads to be shorted \nout for initial programming."
		(exclude_from_sim no)
		(at 200.152 92.71 0)
		(effects
			(font
				(size 1.524 1.524)
			)
		)
		(uuid "29d27d40-5145-4e41-8222-d413e6a3f3fa")
	)
	(text "39SF010 (128K) fitted as standard\nvery little need for alternative\nfiling systems on 8-bit podules. \nBoth switches on allow the full\n128K to be used, or treat as \n4 x 32K section for alternative \nfiling systems.\n39SF010 only goes up to A16."
		(exclude_from_sim no)
		(at 243.586 79.756 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "53e50889-3915-4f3f-be40-8e50bb65f793")
	)
	(text "Cut track on JP2\nand use PS select from \nIC33 (pin 9 or 10)\non A3000 if stacking\npodule with an existing\npodule"
		(exclude_from_sim no)
		(at 109.22 26.67 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "7daacea5-5c20-4f2f-8174-6518fa653235")
	)
	(text "CH376 Header (USB)"
		(exclude_from_sim no)
		(at 67.564 101.346 0)
		(effects
			(font
				(size 1.524 1.524)
			)
		)
		(uuid "c611c0c8-dc54-4d8b-80d6-563788b6c5b8")
	)
	(text "Short to disable the flash\nif the contents prevents \nthe machine from starting.\nNo need for jumper pins\njust poke a wire in the \nholes if needed."
		(exclude_from_sim no)
		(at 76.2 140.208 0)
		(effects
			(font
				(size 1.524 1.524)
			)
		)
		(uuid "e5908fc3-75bf-4660-922c-f6eadb9e8e45")
	)
